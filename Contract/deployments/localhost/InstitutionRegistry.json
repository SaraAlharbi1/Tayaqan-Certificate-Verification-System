  "metadata": "{\"compiler\":{\"version\":\"0.8.28+commit.7893614a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":false,\"internalType\":\"string\",\"name\":\"institutionId\",\"type\":\"string\"},{\"indexed\":false,\"internalType\":\"string\",\"name\":\"name\",\"type\":\"string\"},{\"indexed\":false,\"internalType\":\"address\",\"name\":\"certificateContract\",\"type\":\"address\"}],\"name\":\"InstitutionRegistered\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"admin\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"string\",\"name\":\"_institutionId\",\"type\":\"string\"}],\"name\":\"getInstitution\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"},{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"},{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}],\"name\":\"institutions\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"name\",\"type\":\"string\"},{\"internalType\":\"address\",\"name\":\"certificateContract\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"institutionWallet\",\"type\":\"address\"},{\"internalType\":\"bool\",\"name\":\"isActive\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"string\",\"name\":\"_institutionId\",\"type\":\"string\"},{\"internalType\":\"string\",\"name\":\"_name\",\"type\":\"string\"},{\"internalType\":\"address\",\"name\":\"_certificateContract\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"_institutionWallet\",\"type\":\"address\"}],\"name\":\"registerInstitution\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/InstitutionRegistry.sol\":\"InstitutionRegistry\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":false,\"runs\":1200},\"remappings\":[]},\"sources\":{\"contracts/InstitutionRegistry.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\r\\npragma solidity ^0.8.19;\\r\\ncontract InstitutionRegistry {  \\r\\n    struct Institution {\\r\\n        string name;\\r\\n        address certificateContract;\\r\\n        address institutionWallet;\\r\\n        bool isActive;\\r\\n    }   \\r\\n    address public admin;\\r\\n    mapping(string => Institution) public institutions;  \\r\\n    event InstitutionRegistered(string institutionId, string name, address certificateContract);\\r\\n  \\r\\n    modifier onlyAdmin() {\\r\\n        require(msg.sender == admin, \\\"Only admin\\\");\\r\\n        _;\\r\\n    }  \\r\\n    constructor() {\\r\\n        admin = msg.sender;\\r\\n    }\\r\\n    \\r\\n    function registerInstitution(\\r\\n        string memory _institutionId,\\r\\n        string memory _name,\\r\\n        address _certificateContract,\\r\\n        address _institutionWallet\\r\\n    ) external onlyAdmin {\\r\\n        institutions[_institutionId] = Institution({\\r\\n            name: _name,\\r\\n            certificateContract: _certificateContract,\\r\\n            institutionWallet: _institutionWallet,\\r\\n            isActive: true\\r\\n        });\\r\\n        \\r\\n        emit InstitutionRegistered(_institutionId, _name, _certificateContract);\\r\\n    }\\r\\n    \\r\\n    function getInstitution(string memory _institutionId) \\r\\n        external view returns (string memory, address, address, bool) \\r\\n    {\\r\\n        Institution memory inst = institutions[_institutionId];\\r\\n        return (inst.name, inst.certificateContract, inst.institutionWallet, inst.isActive);\\r\\n    }\\r\\n}\\r\\n\",\"keccak256\":\"0x7dc25496bee42314c312897f1675c58562e6f15e9a43c944d92300757235d9bb\",\"license\":\"MIT\"}},\"version\":1}",
